          "properties": {
            "registrationCode": { "type": ["string", "null"], "maxLength": 160 },
            "registrationDesc": { "type": ["string", "null"], "maxLength": 160 },
            "openingsAvailable": { "type": ["boolean", "null"] },
            "tancada": { "type": ["boolean", "null"] },
            "isFinished": { "type": ["boolean", "null"] }
          }
        },
        "apoyos": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "actividad",
            "edicion",
            "registrationCode",
            "registrationDesc",
            "openingsAvailable",
            "tancada",
            "isFinished",
            "calendario"
          ],
          "properties": {
            "actividad": { "type": "integer", "minimum": 0 },
            "edicion": { "type": "integer", "minimum": 0 },
            "registrationCode": { "type": "integer", "minimum": 0 },
            "registrationDesc": { "type": "integer", "minimum": 0 },
            "openingsAvailable": { "type": "integer", "minimum": 0 },
            "tancada": { "type": "integer", "minimum": 0 },
            "isFinished": { "type": "integer", "minimum": 0 },
            "calendario": { "type": "integer", "minimum": 0 }
          }
        }
      },
      "description": "Matrícula observada para una edición nativa de Cibernàrium, solo política Barcelona Activa 2. Python coteja los IDs y localizadores del mismo objeto/captura, DISP0 corroborado, calendario de esa edición y TTL. No inventa plazo de matrícula, acceso al aula, admisión personal ni plaza reservada. El productor debe reextraer estos hechos del cuerpo admitido."
    },
