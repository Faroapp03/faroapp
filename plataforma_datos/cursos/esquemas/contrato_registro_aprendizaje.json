{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registro compartido de identidades de competencias y escalas",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "competencias", "escalas"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "competencias": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["marco", "version", "codigo", "denominacion", "fuente"],
        "properties": {
          "marco": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "codigo": {
            "type": "string",
            "minLength": 1
          },
          "denominacion": {
            "type": "string",
            "minLength": 1
          },
          "fuente": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "escalas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "denominacion", "fuente", "valores"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "denominacion": {
            "type": "string",
            "minLength": 1
          },
          "fuente": {
            "type": "string",
            "minLength": 1
          },
          "valores": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "description": "Identidades verificadas con procedencia; añadir un marco exige conservar su versión y comprobar sus referencias. La unicidad por identidad compuesta se valida en el núcleo. Valores literales sin orden, equivalencias ni correspondencias implícitas."
}
