          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "normalizacion_categorias": {
                "properties": {
                  "estado": {
                    "const": "no_indicado"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "categorias": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "properties": {
              "normalizacion_categorias": {
                "properties": {
                  "estado": {
                    "const": "normalizado"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "categorias": {
