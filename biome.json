{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "files": {
    "maxSize": 2000000,
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!dist.grafo-emitido.json",
      "!.web-local",
      "!.web-local.etapa-*",
      "!.venv",
      "!package-lock.json",
      "!datos",
      "!var/actualizacion",
      "!plataforma_datos/ia_y_trabajo/pruebas/datos/*.html",
      "!plataforma_datos/cursos/pruebas/capturas_hp_life_indice/*.html",
      "!plataforma_datos/cursos/pruebas/capturas_ciber_bajas/*.html",
      "!web/recursos/catalogo-cursos/lector.js",
      "!web/terceros/noble",
      "!web/terceros/qrcode-generator",
      "!web/imagenes/banderas/*.svg"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "html": {
    "formatter": {
      "enabled": true,
      "whitespaceSensitivity": "strict",
      "selfCloseVoidElements": "always"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUndeclaredVariables": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 12
          }
        },
        "noExcessiveLinesPerFunction": {
          "level": "error",
          "options": {
            "maxLines": 40,
            "skipBlankLines": true
          }
        },
        "useMaxParams": {
          "level": "error",
          "options": {
            "max": 4
          }
        }
      },
      "style": {
        "noNestedTernary": "error",
        "noParameterAssign": "error",
        "useBlockStatements": "error",
        "noMagicNumbers": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 400,
            "skipBlankLines": true
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/plataforma/extensiones-instaladas.ts"],
      "linter": {
        "rules": {
          "complexity": {
            "noUselessEmptyExport": "off"
          }
        }
      }
    },
    {
      "includes": ["plataforma_datos/biblioteca/fuentes/lecturas/catalogo.json"],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["web/datos/catalogo-cursos/*.json", "web/datos/catalogo-aprendizaje/*.json"],
      "files": {
        "maxSize": 33554432
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "motores/ocupaciones/src/busqueda/complemento.ts",
        "motores/ocupaciones/src/busqueda/consulta.ts",
        "motores/ocupaciones/src/busqueda/denominaciones-oficiales.ts",
        "motores/ocupaciones/src/busqueda/ocupaciones.ts"
      ],
      "assist": {
        "actions": {
          "source": {
            "organizeImports": "off"
          }
        }
      },
      "linter": {
        "rules": {
