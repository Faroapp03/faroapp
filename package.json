{
  "name": "faro",
  "version": "1.0.0",
  "private": true,
  "description": "Faro: aplicación y herramientas propias de mantenimiento.",
  "author": "Equipo Faro",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "construir": "node herramientas/web/construir.ts",
    "servir": "node herramientas/servidor/servidor-local.ts",
    "cloudflare:comprobar": "node herramientas/cloudflare/comprobar-construccion.ts",
    "cloudflare:artefacto": "node herramientas/cloudflare/artefacto.ts",
    "cloudflare:desplegar": "node herramientas/cloudflare/desplegar.ts",
    "cloudflare:actualizar-acceso-web": "node herramientas/cloudflare/actualizar-acceso-web.ts",
    "cloudflare:actualizar-portada": "node herramientas/cloudflare/actualizar-portada.ts",
    "cloudflare:comprobar-acceso-web": "node herramientas/cloudflare/actualizar-acceso-web.ts --comprobar",
    "cloudflare:comprobar-portada": "node herramientas/cloudflare/actualizar-portada.ts --comprobar",
    "verificar": "node scripts/verificar.ts",
    "verificar:datos": "node scripts/verificar-datos.ts",
    "verificar:datos-variantes": "node scripts/verificar-datos-variantes.ts",
    "mantenimiento:ensayar": ".venv/bin/python -m plataforma_datos.orquestacion.simular_mantenimiento",
    "mantenimiento:diagnosticar": ".venv/bin/python -m plataforma_datos.orquestacion.salud_mantenimiento",
    "mantenimiento:registro": ".venv/bin/python -m plataforma_datos.orquestacion.ejecutar_mantenimiento registro",
    "ensayo:sin-extension": "node scripts/ensayo-sin-extension.ts",
    "juntas:comprobar": "node herramientas/git/comprobar-juntas.ts",
    "probar:navegadores": "node pruebas/navegadores/ensayo.ts",
    "probar:descargas-js": "node pruebas/navegadores/descargas-js.mjs",
    "probar:modulo-alterado": "node pruebas/navegadores/modulo-alterado.mjs",
    "probar:copia-en-el-dispositivo": "node pruebas/navegadores/copia-en-el-dispositivo.mjs",
    "probar:webmcp-paquete": "node pruebas/navegadores/webmcp-paquete.mjs",
    "probar:actualizacion-sw": "node pruebas/navegadores/actualizacion-sw.mjs",
    "probar:arranque-bloqueado": "node pruebas/navegadores/arranque-bloqueado.test.mjs",
    "probar:instalacion-con-carga": "node pruebas/navegadores/instalacion-con-carga.test.mjs",
    "probar:presupuesto": "node pruebas/navegadores/presupuesto-rendimiento.mjs",
    "probar:motor-empaquetado": "node scripts/probar-motor-empaquetado.ts",
    "test": "node scripts/verificar.ts --pruebas",
    "probar:cursos": "node --import=./pruebas/ayudas/sin-red.ts --test motores/cursos/pruebas/*.test.ts",
    "probar:ocupaciones": "node --import=./pruebas/ayudas/sin-red.ts --test motores/ocupaciones/pruebas/*.test.ts",
    "ocupaciones:sellar": "node motores/ocupaciones/herramientas/sellar.ts",
    "ocupaciones:comprobar-sello": "node motores/ocupaciones/herramientas/sellar.ts --comprobar",
    "ocupaciones:atributos": "node motores/ocupaciones/herramientas/generar-atributos.ts",
    "ocupaciones:comprobar-atributos": "node motores/ocupaciones/herramientas/generar-atributos.ts --comprobar",
    "ocupaciones:medir": "node motores/ocupaciones/herramientas/medir-casos.ts",
    "tipos": "node scripts/tipos.ts",
    "estilo": "node node_modules/@biomejs/biome/bin/biome check --error-on-warnings .",
    "api:generar": "node herramientas/api/openapi.ts",
    "api:comprobar": "node herramientas/api/openapi.ts --comprobar",
    "datos:exportar": ".venv/bin/python -m plataforma_datos.orquestacion.exportar_paquete",
    "datos:actualizar": ".venv/bin/python -m plataforma_datos.orquestacion.actualizar",
    "datos:catalogo": ".venv/bin/python -B -m plataforma_datos.orquestacion.catalogo_de_datos",
    "datos:estado": ".venv/bin/python -m plataforma_datos.orquestacion.estado_de_los_datos",
    "datos:reconstruir": ".venv/bin/python -m plataforma_datos.orquestacion.reconstruir",
    "comunes:generar": "node herramientas/web/comunes.ts",
    "comunes:comprobar": "node herramientas/web/comunes.ts --comprobar",
    "globales:generar": "node herramientas/web/datos-globales.ts",
    "globales:comprobar": "node herramientas/web/datos-globales.ts --comprobar",
    "globo:generar": "node herramientas/web/traer-globo.ts",
    "lecturas:generar": "node herramientas/web/lecturas.ts",
    "lecturas:comprobar": "node herramientas/web/lecturas.ts --comprobar",
    "web:preparar": "node herramientas/web/construir.ts --local",
    "web:comprobar": "node herramientas/web/preparar.ts --comprobar",
    "informe:ejemplo": "node herramientas/web/informe-ejemplo.ts",
    "informe:comprobar": "node herramientas/web/informe-ejemplo.ts --comprobar",
    "cursos:foto": "node herramientas/catalogo-cursos/foto-clasificacion.ts",
    "cursos:foto-comprobar": "node herramientas/catalogo-cursos/foto-clasificacion.ts --comprobar"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.3",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "parse5": "8.0.1",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2",
    "wrangler": "4.151.1",
    "yaml": "2.9.1"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
