{
  "name": "faro-ensayo",
  "main": "../../../dist/worker/worker.mjs",
  "base_dir": "../../../dist/worker",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": {
    "directory": "../../../dist/web",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "rules": [{ "type": "Data", "globs": ["**/datos/*.json"], "fallthrough": true }],
  "durable_objects": { "bindings": [{ "name": "REGISTRO_SOCIOS", "class_name": "AccesoPublicoDurable" }] },
  "migrations": [{ "tag": "faro-ensayo-inicial-v1", "new_sqlite_classes": ["AccesoPublicoDurable"] }],
  "services": [{ "binding": "CURSOS", "service": "faro-ensayo-cursos" }]
}
